# 값을 채운 뒤 .env로 복사합니다. 실제 키는 Git에 올리지 않습니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# AI 평가로 정한 코사인 유사도 기준값(-1~1). 비어 있으면 후보 확인만 수행.
CLIP_MATCH_THRESHOLD=
# 실제 촬영본 평가로 정한 high 기준. match 이상이어야 하며 둘 다 설정해야 high 반환.
CLIP_HIGH_CONFIDENCE_THRESHOLD=
CLIP_MODEL=ViT-B-32-quickgelu
CLIP_PRETRAINED=openai
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# --- AI 파트 (Backend/ai) ---
# 파인튜닝 어댑터(data/clip-adapter.npz) 사용 여부. evaluation.py가 on/off를 추천한다. 바꾸면 build_index.py를 다시 실행.
CLIP_ADAPTER=on
# 작품/작품 아님 판별 기준(0~1). evaluation.py가 추천한다. off로 끌 수 있다.
ARTWORK_GATE_THRESHOLD=0.5
# 1이면 서버 시작 때 CLIP 모델·인덱스를 미리 불러 첫 인식도 빠르게 한다(시연용 권장).
CLIP_WARMUP=1
# Gemini 유료 API 예산 상한(원). 호출 전 '사용액 + 1회 최대 비용'이 넘으면 호출하지 않는다. 사용액은 data/gemini-usage.json.
GEMINI_BUDGET_KRW=12000
GEMINI_DAILY_LIMIT=300
# 비용 계산용 단가(USD/100만 토큰)와 환율. 모델을 바꾸면 단가도 바꾼다.
GEMINI_INPUT_USD_PER_M=0.25
GEMINI_OUTPUT_USD_PER_M=1.50
GEMINI_KRW_PER_USD=1500

# OpenAI 음성 (Gemini 키와 별개, 음성 생성 비용도 별도)
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
OPENAI_TTS_VOICE=cedar
# 모델·요금이 바뀌면 갱신. 출력 전체를 오디오 단가로 보수적으로 계산.
OPENAI_TTS_BUDGET_KRW=12000
OPENAI_TTS_DAILY_LIMIT=300
OPENAI_TTS_INPUT_USD_PER_M=0.60
OPENAI_TTS_OUTPUT_USD_PER_M=20
OPENAI_TTS_KRW_PER_USD=1500

# OpenAI 음성 인식 (화면 맞추기 숫자 답 등 짧은 말). 키는 위 OPENAI_API_KEY를 같이 쓴다.
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_BUDGET_KRW=3000
OPENAI_STT_DAILY_LIMIT=500
