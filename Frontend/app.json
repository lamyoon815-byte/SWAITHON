{
  "expo": {
    "name": "MoMi",
    "slug": "momi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "momi",
      "swaithon"
    ],
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C1D21",
          "image": "./assets/images/mascot/chameleon.png",
          "imageWidth": 220
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "작품이나 명패를 촬영해 작품을 인식하려면 카메라 권한이 필요합니다.",
          "microphonePermission": "화면 맞추기에서 보이는 숫자를 말로 답하려면 마이크 권한이 필요합니다.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "화면 맞추기에서 보이는 숫자를 말로 답하려면 마이크 권한이 필요합니다.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진으로 쓸 사진을 고르려면 사진 접근 권한이 필요합니다.",
          "cameraPermission": "작품을 촬영하거나 프로필 사진을 찍으려면 카메라 권한이 필요합니다.",
          "microphonePermission": "화면 맞추기에서 보이는 숫자를 말로 답하려면 마이크 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
