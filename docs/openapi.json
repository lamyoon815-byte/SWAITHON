    },
    "/me/ai-profile": {
      "get": {
        "tags": [
          "시각 프로필"
        ],
        "summary": "AI 보정 프로필 조회 (미설정 시 null)",
        "operationId": "get_ai_profile_me_ai_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AIProfile"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "title": "Response Get Ai Profile Me Ai Profile Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "시각 프로필"
        ],
        "summary": "AI 보정 프로필 전체 저장",
        "description": "6필드 AI 규격. 생략한 필드는 기본값으로 저장합니다. 기존 /me/profile과 독립적이며 밝기 단위를 자동 변환하지 않습니다.",
        "operationId": "put_ai_profile_me_ai_profile_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/me/history/{history_id}": {
      "delete": {
        "tags": [
          "관람 기록"
        ],
        "summary": "내 관람 기록 삭제",
        "operationId": "delete_history_me_history__history_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "history_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "History Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/correction": {
      "post": {
        "tags": [
          "이미지 보정"
        ],
        "summary": "등록 원본 또는 촬영본에 AI 프로필 보정 적용",
        "operationId": "correction_correction_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_correction_correction_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "503": {
            "description": "AI 보정 함수 미연결"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/recognize": {
      "post": {
        "tags": [
          "작품 인식"
        ],
        "summary": "촬영 사진·명패로 작품 후보 상위 3개 조회",
        "description": "로그인 필요. mode=artwork는 CLIP 코사인 유사도, placard는 명패 텍스트 매칭 점수입니다. 점수는 확률이 아니며 후보 확인이 필요합니다. 사진은 저장하지 않습니다.",
        "operationId": "recognize_recognize_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_recognize_recognize_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecognitionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/analyze": {
      "post": {
        "tags": [
          "작품 해설"
        ],
        "summary": "미등록 작품의 실시간 한국어 해설 생성",
        "description": "로그인 필요. Gemini로 사실·감정 해석·영역·분위기 키워드를 생성합니다. 미검수 결과임을 표시하고 사진과 결과는 DB에 저장하지 않습니다.",
        "operationId": "analyze_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/artworks/{artwork_id}/narration": {
      "get": {
        "tags": [
          "작품 해설"
        ],
        "summary": "내 감상 모드에 맞는 검수 해설 텍스트 조회",
        "description": "기본 모드는 계정의 narration_mode를 사용합니다. 반환된 text를 앱의 expo-speech로 재생합니다.",
        "operationId": "narration_artworks__artwork_id__narration_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "artwork_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Artwork Id"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "facts",
                    "interpretations",
                    "both"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Mode"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NarrationResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "서버 상태"
        ],
        "summary": "서버 상태 확인",
        "description": "서버가 정상적으로 실행 중이면 `status: ok`를 반환합니다.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "tags": [
          "사진 업로드"
        ],
        "summary": "사진 업로드 및 JPEG 변환",
        "description": "사진의 실제 형식을 검사하고 회전 보정·RGB 변환 후 JPEG로 인코딩합니다. 응답의 `source_format`은 입력 형식, `format`은 변환된 형식입니다. 현재는 변환 결과의 크기·가로·세로 등 정보만 반환하며, 사진을 영구 저장하거나 작품 DB에 등록하지 않습니다.",
        "operationId": "upload_image_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_image_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "빈 파일이거나 읽을 수 없는 이미지"
          },
          "413": {
            "description": "파일 용량 또는 이미지 해상도 제한 초과"
          },
          "415": {
            "description": "지원하지 않는 이미지 형식"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/artworks": {
      "get": {
        "tags": [
          "작품 조회"
        ],
        "summary": "등록된 작품 목록 조회",
        "description": "DB에 등록된 작품 목록과 전체 작품 수를 반환합니다. `limit`과 `offset`으로 조회 범위를 지정할 수 있습니다. 각 작품에는 원본 이미지 URL이 포함되며, 미검수 해설은 `null`로 반환합니다.",
        "operationId": "list_artworks_artworks_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "한 번에 가져올 작품 수 (1~100)",
              "default": 20,
              "title": "Limit"
            },
            "description": "한 번에 가져올 작품 수 (1~100)"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "앞에서 건너뛸 작품 수 (0부터 시작)",
              "default": 0,
              "title": "Offset"
            },
            "description": "앞에서 건너뛸 작품 수 (0부터 시작)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtworkList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/artworks/by-number": {
      "get": {
        "tags": [
          "작품 조회"
        ],
        "summary": "작품 번호로 작품 조회",
        "description": "작품 번호로 작품 상세 정보를 조회합니다. 응답 형식은 작품 상세 조회와 같습니다. 번호는 미술관별로 고유하므로, 여러 미술관에 같은 번호가 있으면 `museum`을 함께 보내야 합니다.",
        "operationId": "get_artwork_by_number_artworks_by_number_get",
        "parameters": [
          {
            "name": "number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "작품 번호",
              "examples": [
                "INV 779"
              ],
              "title": "Number"
            },
            "description": "작품 번호"
          },
          {
            "name": "museum",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "미술관 이름",
              "examples": [
                "루브르 박물관"
              ],
              "title": "Museum"
            },
            "description": "미술관 이름"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtworkDetail"
                }
              }
            }
          },
          "404": {
            "description": "해당 번호로 등록된 작품이 없음"
          },
          "409": {
            "description": "여러 미술관에 같은 번호가 있어 museum 지정이 필요함"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/artworks/{artwork_id}": {
      "get": {
        "tags": [
