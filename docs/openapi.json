          "시각 프로필"
        ],
        "summary": "내 시각 프로필 전체 저장",
        "description": "앱에서 선택한 설정을 계정에 저장합니다. 생략한 필드는 기본값으로 저장됩니다. 이미지는 앱에서 보정합니다.",
        "operationId": "put_profile_me_profile_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VisualProfile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VisualProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/me/history": {
      "post": {
        "tags": [
          "관람 기록"
        ],
        "summary": "작품과 감상 당시 보정 설정 기록",
        "operationId": "add_history_me_history_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HistoryInput"
              }
            }
          }
        },
        "responses": {
          "201": {
